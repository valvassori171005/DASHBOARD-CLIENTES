# Copie para .env (local) ou cadastre na Vercel: Settings → Environment Variables.
# NUNCA commite o .env. Nenhuma destas variáveis chega ao navegador.

# ---- Geral ----
CLIENT_NAME="Hospital São José"
# Nome que aparece no dash para a métrica de conversão (ex.: Leads, Agendamentos, Conversas)
CONVERSION_LABEL="Leads"
# 1 = usa dados sintéticos (só para desenvolvimento; o dash exibe um aviso)
DEMO_MODE=0

# ---- Meta Ads ----
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_000000000000000
META_API_VERSION=v23.0
# action_types somados como "conversão" (separados por vírgula). "lead" = todos os leads.
# Ex.: onsite_conversion.messaging_conversation_started_7d para conversas no WhatsApp/Direct.
META_CONVERSION_ACTIONS=lead
# action_types de valor (receita) para ROAS. Deixe vazio se não houver receita.
META_REVENUE_ACTIONS=offsite_conversion.fb_pixel_purchase
# inline_link_clicks (cliques no link, padrão) ou clicks (cliques - todos)
META_CLICKS_FIELD=inline_link_clicks

# ---- Google Ads (API direta) ----
GADS_DEVELOPER_TOKEN=
GADS_CLIENT_ID=
GADS_CLIENT_SECRET=
GADS_REFRESH_TOKEN=
GADS_CUSTOMER_ID=000-000-0000
GADS_LOGIN_CUSTOMER_ID=000-000-0000
GADS_API_VERSION=v23
# Opcional: nomes exatos das ações de conversão a contar (separados por vírgula).
# Vazio = usa a coluna "Conversões" do Google Ads (ações marcadas como principais).
GADS_CONVERSION_ACTIONS=

# ---- Google Ads (plano B: script + ingest) ----
# api | script. Sem GADS_MODE: usa "api" se houver GADS_DEVELOPER_TOKEN, senão "script".
GADS_MODE=
# Segredo compartilhado com o Script do Google Ads (gere com: openssl rand -hex 32)
INGEST_SECRET=
# Upstash Redis (Vercel → Storage → Upstash). A integração cria estas variáveis sozinha.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Cloudflare Access (proteção também da URL *.vercel.app) ----
# Equipe: <equipe>.cloudflareaccess.com → CF_ACCESS_TEAM_DOMAIN=<equipe>.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) Tag da aplicação no Access
CF_ACCESS_AUD=
